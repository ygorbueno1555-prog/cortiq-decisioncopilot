# Cortiq Decision Copilot v2 — Environment Variables

# Claude API (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# Tavily web search (required)
TAVILY_API_KEY=your_tavily_api_key_here

# Morning Brief email delivery (optional)
RESEND_API_KEY=your_resend_api_key_here
BRIEF_FROM_EMAIL=onboarding@resend.dev

# ── Thunder GTM Monitor ────────────────────────────────────────────────────────

# Path to the thunder-gtm directory (read-only snapshot)
THUNDER_GTM_DIR=/root/thunder-gtm

# Gateway token (inline value or path to a file containing the token)
THUNDER_GATEWAY_TOKEN=
THUNDER_TOKEN_PATH=   # e.g. /root/thunder-gtm/.gateway_token

# Local Thunder agent base URL
THUNDER_AGENT_URL=http://localhost:8080

# Cron behaviour
THUNDER_CRON_TIMEOUT=600       # hard timeout in seconds (default 10 min)
THUNDER_MAX_FINDINGS=3         # max findings per Telegram report
THUNDER_DEDUP_TTL_HOURS=24     # suppress repeated alerts for this many hours
THUNDER_AGENT_TIMEOUT=15       # per-request timeout to local agent
THUNDER_AGENT_RETRIES=3        # retry attempts on transient agent failures

# Telegram notifications (use a dedicated monitor bot/chat, not the main chat)
TELEGRAM_BOT_TOKEN=
TELEGRAM_MONITOR_CHAT_ID=      # separate from TELEGRAM_CHAT_ID used by main bot

# ── GTM Stack Credentials (healthcheck — read-only) ───────────────────────────

HUBSPOT_ACCESS_TOKEN=
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIRECRAWL_API_KEY=     # optional — skip if using local containers
APOLLO_API_KEY=        # pending: enrollment checks disabled without this
UNIPILE_API_KEY=
UNIPILE_ACCOUNT_ID=    # pending: LinkedIn not linked without this
UNIPILE_DSN=api4.unipile.com:13465
CLAY_API_KEY=
